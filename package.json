{
  "name": "laboratorio",
  "version": "0.1.0",
  "private": true,
  "description": "Laboratorio de simulaciones de física (estático, sin compilación)",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:unit": "SKIP_SMOKE=1 node --test \"tests/*.test.js\"",
    "check": "tsc --noEmit -p tsconfig.json",
    "vendor": "node tools/vendor.mjs",
    "serve": "node tools/serve.mjs --base /laboratorio/"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "katex": "0.19.1",
    "three": "0.187.0",
    "typescript": "7.0.2"
  }
}
